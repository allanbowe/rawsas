# Dependency install scripts do not run unattended (supply-chain hardening).
#
# sharp 0.32 is the one package that needs its install script, to fetch the
# libvips prebuild. `npm rebuild` also inherits ignore-scripts, so after any
# install run:
#
#   npm rebuild sharp --ignore-scripts=false
#
# CI does this in both workflows. Without it the build fails with
# "Cannot find module '../build/Release/sharp-linux-x64.node'".
ignore-scripts=true
save-exact=true
